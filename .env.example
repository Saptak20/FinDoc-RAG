# Application Configuration
APP_NAME=FinDoc-RAG
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# Security & CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMITING_ENABLED=True
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DELETE=10/minute

# Local Ollama LLM & Embedding Service
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL Database (Async SQLAlchemy)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findoc_rag

# Local Storage Paths & Ingestion Limits
VECTOR_STORE_PATH=./data/vector_store
RAW_DATA_PATH=./data/raw
MAX_UPLOAD_SIZE_MB=50

# Document Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & Reranking Settings
TOP_K=10
FINAL_CONTEXT_K=3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

