# Application
APP_NAME=FinDoc-RAG
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_URL=postgresql://postgres:my_postgre_password@localhost:5432/findoc_rag

# Vector Store
VECTOR_STORE_PATH=./data/vector_store

# Raw Documents
RAW_DATA_PATH=./data/raw

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=10
FINAL_CONTEXT_K=3